# No trailing slash, deliberately: scripts/worktree.sh links node_modules rather
# than copying 170MB per worktree, and `node_modules/` matches a directory but
# not a symlink to one — which left every worktree permanently reporting an
# untracked node_modules, one `git add -A` away from committing a symlink.
node_modules
dist/
.DS_Store
*.local
.vite/
.claude/settings.local.json
